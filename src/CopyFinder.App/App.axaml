<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CopyFinder.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
    </Style>

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="Background" Value="#282D34" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#343B45" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderBrush" Value="#FF6961" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="13,5" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Background" Value="#F7F8FA" />
      <Setter Property="Foreground" Value="#15171A" />
      <Setter Property="BorderBrush" Value="#6C7682" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="TextBox.settings">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Background" Value="#242931" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.result-row">
      <Setter Property="Background" Value="#111214" />
      <Setter Property="BorderBrush" Value="#262B32" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.result-row.odd">
      <Setter Property="Background" Value="#192330" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#08090B" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#111214" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1B1E22" />
    <SolidColorBrush x:Key="GroupHeaderBrush" Color="#1E2A3A" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#303944" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#0797F2" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="#55C7FF" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#B8BEC7" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF3B30" />
  </Application.Resources>
</Application>
